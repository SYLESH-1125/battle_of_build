# ── Backend (set these in Render's environment variables panel) ──────────────

# API key protecting the /ingest and /admin endpoints
VAULT_API_KEY=your-secret-api-key

# Redis connection URL (use Upstash Redis for a free managed option)
REDIS_URL=redis://localhost:6379

# Supabase project URL and keys (found in Supabase → Project Settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SECRET_KEY=your-supabase-service-role-key

# Deployed frontend URL — set to your Vercel URL so CORS works
# Example: https://your-project.vercel.app
FRONTEND_URL=

# LLM / AI settings
PHI_TO_CLOUD_ALLOWED=true
LLM_CLOUD_KEY=your-groq-api-key
LLM_CLOUD_PROVIDER=groq
LLM_CLOUD_MODEL=qwen/qwen3-32b
LLM_CLOUD_TIMEOUT_MS=10000
LLM_LOCAL_ENDPOINT=http://localhost:8080/v1
LLM_LOCAL_TIMEOUT_MS=3000


# ── Frontend (set these in Vercel's environment variables panel) ─────────────

# Supabase (must be prefixed NEXT_PUBLIC_ so Next.js bundles them client-side)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Deployed backend URL — set to your Render service URL
# Example: https://memory-vault-backend.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# API key used by the frontend to call the backend (must match VAULT_API_KEY above)
NEXT_PUBLIC_VAULT_API_KEY=your-secret-api-key

# Full URL of this frontend app (used for OAuth redirect callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000
